# =============================================================================
# Root .gitignore — LabTech/research
# Catches common junk across the whole repo. Nested .gitignore files in
# SEEU-TCC/ and fabrica_de_software/ add scope-specific rules.
# =============================================================================

# -----------------------------------------------------------------------------
# LaTeX build artifacts
# -----------------------------------------------------------------------------
*.aux
*.bbl
*.bcf
*.blg
*.brf
*.fdb_latexmk
*.fls
*.fmt
*.fot
*.idx
*.ilg
*.ind
*.lof
*.log
*.lot
*.nav
*.out
*.run.xml
*.snm
*.synctex
*.synctex.gz
*.toc
*.vrb
*.xdv
*.dvi
*.ps
*-blx.aux
*-blx.bib
*.acn
*.acr
*.glg
*.glo
*.gls
*.glsdefs
*.lol
*.tdo
_minted-*/
**/_minted-*/
*.pyg

# -----------------------------------------------------------------------------
# Python
# -----------------------------------------------------------------------------
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
*.egg-info/
*.egg
.venv/
venv/
env/
ENV/
.python-version
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
.ipynb_checkpoints/

# -----------------------------------------------------------------------------
# Node / JS
# -----------------------------------------------------------------------------
node_modules/
**/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.eslintcache

# -----------------------------------------------------------------------------
# Editors / IDEs
# -----------------------------------------------------------------------------
.vscode/
.idea/
*.swp
*.swo
*~
.project
.settings/
*.sublime-project
*.sublime-workspace

# -----------------------------------------------------------------------------
# OS files
# -----------------------------------------------------------------------------
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# -----------------------------------------------------------------------------
# Temp / backup / archive
# -----------------------------------------------------------------------------
*.bak
*.backup
*.orig
*.rej
*.tmp
*.temp
*.zip
*.tar.gz
*.rar
*.7z

# -----------------------------------------------------------------------------
# Secrets / local config
# -----------------------------------------------------------------------------
.env
.env.local
.env.*.local
*.key
*.pem
secrets.json
